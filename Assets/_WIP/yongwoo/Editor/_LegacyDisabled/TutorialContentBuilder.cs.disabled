using System.Collections.Generic;
using UnityEditor;
using UnityEditor.SceneManagement;
using UnityEngine;

// 에디터 전용: 튜토리얼 시퀀스/트리거/진행 차단/상호작용을 한번에 생성하는 빌더.
// 메뉴 Tools > 튜토리얼 콘텐츠 생성 으로 실행.
// 실행 후 이 파일은 삭제해도 된다.

public static class TutorialContentBuilder
{
    [MenuItem("Tools/튜토리얼 콘텐츠 생성")]
    public static void Build()
    {
        var root = GameObject.Find("튜토리얼진행");
        if (root == null)
        {
            Debug.LogError("튜토리얼진행 오브젝트를 찾을 수 없습니다.");
            return;
        }

        var 시퀀스부모 = root.transform.Find("시퀀스");
        var 트리거부모 = root.transform.Find("트리거");
        var 상호작용부모 = root.transform.Find("상호작용");
        var 진행차단부모 = root.transform.Find("진행차단") ?? root.transform.Find("게이트");
        var 스폰부모 = root.transform.Find("스폰포인트");

        // 스폰 포인트 참조
        Transform 스폰_접속구역 = 스폰부모?.Find("스폰_접속구역");
        Transform 스폰_주인공집 = 스폰부모?.Find("스폰_주인공집");
        Transform 스폰_광장 = 스폰부모?.Find("스폰_광장");
        Transform 스폰_골목길 = 스폰부모?.Find("스폰_골목길");
        Transform 스폰_접속공중 = 스폰부모?.Find("착지연출_공중위치") ?? 스폰_접속구역;
        Transform 스폰_재접속_047 = 스폰부모?.Find("스폰_재접속_047");
        if (스폰_재접속_047 == null)
        {
            Debug.LogWarning("[TutorialContentBuilder] '스폰_재접속_047' 스폰 포인트가 없어 '스폰_접속공중'으로 fallback. 골목길 칩접속 결말이 의도된 위치로 가지 않을 수 있음 — 수동 배치 필요.");
            스폰_재접속_047 = 스폰_접속공중;
        }
        DeleteChildIfExists(root.transform, "포커스_첫적");
        DeleteChildIfExists(root.transform, "포커스_연속전투");
        DeleteChildIfExists(root.transform, "포커스_원거리적");

        // 시퀀스별 카메라 포커스 대상을 적 prefab 이름으로 매칭.
        // 사용자가 적 이름을 바꾸거나 새 적을 추가하면 fallback으로 첫 번째 활성 적 사용.
        Transform 적포커스_첫적 = FindEnemyByName("Brawler") ?? FindEnemyFocusTarget();
        Transform 적포커스_연속전투 = FindEnemyByName("Swordsman") ?? FindEnemyFocusTarget();
        Transform 적포커스_원거리 = FindEnemyByName("Gunner") ?? FindEnemyFocusTarget();

        // 주의: ClearChildren 호출 제거됨.
        // 기존 오브젝트를 삭제하지 않고, 이름이 같은 경우만 덮어쓰기합니다.
        // 수동 작업으로 만든 시퀀스/트리거가 유실되는 것을 방지합니다.

        // ========== 구간 1A: 시작 인트로 (검은화면 → 시스템로그 → 공중 텔레포트 → 페이드인 → 자유낙하) ==========
        // 입력은 LockInput으로 막은 채로 종료 (controller는 살아 있어 자유낙하/애니메이션 정상).
        // 입력 해제는 트리거_접속대화 시퀀스 끝에서 UnlockInput으로 처리됨 → 시작부터 대사 끝까지 입력 한 줄로 잠김.
        var 시퀀스_시작연출 = CreateSequence(시퀀스부모, "시퀀스_시작연출", playOnStart: true, new Step[]
        {
            S(StepType.LockInput),
            S(StepType.FadeOut, duration: 0f),
            S(StepType.ShowSystemLog, message: "[접속 중...]", duration: 0.7f),
            S(StepType.ShowSystemLog, message: "[대상: 채무자 047]", duration: 0.7f),
            S(StepType.ShowSystemLog, message: "[회수 파일: HOME]", duration: 0.7f),
            S(StepType.ShowSystemLog, message: "[침입 경로 확보]", duration: 0.7f),
            S(StepType.HideSystemLog),
            S(StepType.TeleportPlayer, targetTransform: 스폰_접속공중),
            S(StepType.SnapCamera),
            S(StepType.FadeIn, duration: 0.5f),
            // UnlockInput 호출 안 함 — 자유낙하 중에도 입력 막힘. 트리거_접속대화에서 대사 끝나면 풀림.
        });

        // ========== 구간 1B: 착지 후 브로커 통신 + 이동 안내 (트리거_접속대화) ==========
        // LockInput으로 입력만 막음 (controller는 살려 중력/애니메이션 정상). 공중에서 멈추는 일 없음.
        var 시퀀스_접속대화 = CreateSequence(시퀀스부모, "시퀀스_접속대화", playOnStart: false, new Step[]
        {
            S(StepType.LockInput),
            S(StepType.ShowCommsLine, speaker: "브로커", message: "들리나?", duration: 1f),
            S(StepType.ShowCommsLine, speaker: "주인공", message: "잡음 심해.", duration: 0.75f),
            S(StepType.ShowCommsLine, speaker: "브로커", message: "파일 하나만 꺼내. 내용은 보지 말고.", duration: 1f),
            S(StepType.ShowCommsLine, speaker: "주인공", message: "늘 하던 대로.", duration: 0.75f),
            S(StepType.HideComms),
            S(StepType.UnlockInput),
            S(StepType.ShowSystemLog, message: "A / D : 이동"),
            S(StepType.WaitForInput, inputWait: InputWaitType.Move),
            S(StepType.FadeSystemLog, alpha: 0f, duration: 0.5f),
            S(StepType.ShowCommsLine, speaker: "브로커", message: "경로는 짧다. 멈추지 마.", duration: 1f),
            S(StepType.HideComms),
        });

        CreateTrigger(트리거부모, "트리거_접속대화", 시퀀스_접속대화);

        // ========== 구간 2: 점프 / 회피 ==========
        var 시퀀스_점프대시 = CreateSequence(시퀀스부모, "시퀀스_점프대시", playOnStart: false, new Step[]
        {
            S(StepType.ShowCommsLine, speaker: "브로커", message: "기억층이 무너진다.", duration: 0.75f),
            S(StepType.GlitchPulse, duration: 0.25f, glitchIntensity: 0.35f),
            S(StepType.CameraShake, duration: 0.18f, strength: 0.08f),
            S(StepType.ShowCommsLine, speaker: "주인공", message: "그럼 빨리 끝내지.", duration: 0.75f),
            S(StepType.HideComms),
            S(StepType.ShowSystemLog, message: "SPACE : 점프"),
            S(StepType.WaitForInput, inputWait: InputWaitType.Jump),
            S(StepType.FadeSystemLog, alpha: 0f, duration: 0.3f),
            S(StepType.Delay, duration: 0.25f),
            S(StepType.ShowSystemLog, message: "↓ + ← / → : 회피"),
            S(StepType.WaitForInput, inputWait: InputWaitType.Roll),
            S(StepType.FadeSystemLog, alpha: 0f, duration: 0.5f),
        });

        CreateTrigger(트리거부모, "트리거_점프대시안내", 시퀀스_점프대시);

        // ========== 구간 3: 첫 적 ==========
        var 시퀀스_첫적 = CreateSequence(시퀀스부모, "시퀀스_첫적", playOnStart: false, new Step[]
        {
            S(StepType.FreezeTime),
            S(StepType.SetCameraTarget, targetTransform: 적포커스_첫적),
            S(StepType.Delay, duration: 0.4f),
            S(StepType.ShowSystemLog, message: "[방어 개체 감지]", duration: 0.5f),
            S(StepType.ShowCommsLine, speaker: "브로커", message: "앞에 하나.", duration: 0.75f),
            S(StepType.ShowCommsLine, speaker: "주인공", message: "보여.", duration: 0.5f),
            S(StepType.HideComms),
            S(StepType.SetCameraTarget), // targetTransform=null → 플레이어로 복귀
            S(StepType.Delay, duration: 0.3f),
            S(StepType.UnfreezeTime),
            S(StepType.ShowSystemLog, message: "마우스 왼클릭 : 공격"),
            S(StepType.WaitForInput, inputWait: InputWaitType.Attack),
            S(StepType.FadeSystemLog, alpha: 0f, duration: 0.5f),
        });

        CreateTrigger(트리거부모, "트리거_첫적", 시퀀스_첫적);

        // 첫 적 처치 후 시퀀스
        var 시퀀스_첫적후 = CreateSequence(시퀀스부모, "시퀀스_첫적처치후", playOnStart: false, new Step[]
        {
            S(StepType.ShowCommsLine, speaker: "주인공", message: "다음.", duration: 0.5f),
            S(StepType.HideComms),
            S(StepType.ShowSystemLog, message: "[경로 개방]", duration: 0.5f),
            S(StepType.HideSystemLog),
        });

        // 진행 차단 (적 연결은 수동으로 해야 함)
        CreateProgressBlocker(진행차단부모, "진행차단_첫적", 시퀀스_첫적후);

        // ========== 구간 4: 연속 전투 ==========
        var 시퀀스_연속전투 = CreateSequence(시퀀스부모, "시퀀스_연속전투", playOnStart: false, new Step[]
        {
            S(StepType.ShowSystemLog, message: "[접속 차단 활성화]", duration: 0.5f),
            S(StepType.GlitchPulse, duration: 0.35f, glitchIntensity: 0.45f),
            S(StepType.FreezeTime),
            S(StepType.SetCameraTarget, targetTransform: 적포커스_연속전투),
            S(StepType.Delay, duration: 0.4f),
            S(StepType.ShowCommsLine, speaker: "브로커", message: "감시 개체 셋.", duration: 0.75f),
            S(StepType.ShowCommsLine, speaker: "주인공", message: "숫자 세지 마. 느려져.", duration: 0.75f),
            S(StepType.HideComms),
            S(StepType.SetCameraTarget),
            S(StepType.Delay, duration: 0.3f),
            S(StepType.UnfreezeTime),
        });

        CreateTrigger(트리거부모, "트리거_연속전투", 시퀀스_연속전투);

        var 시퀀스_연속전투후 = CreateSequence(시퀀스부모, "시퀀스_연속전투후", playOnStart: false, new Step[]
        {
            S(StepType.ShowSystemLog, message: "[경로 개방]", duration: 0.5f),
            S(StepType.HideSystemLog),
        });

        CreateProgressBlocker(진행차단부모, "진행차단_연속전투", 시퀀스_연속전투후);

        // ========== 구간 5: 원거리 적 / 회피 ==========
        var 시퀀스_원거리 = CreateSequence(시퀀스부모, "시퀀스_원거리적", playOnStart: false, new Step[]
        {
            S(StepType.FreezeTime),
            S(StepType.SetCameraTarget, targetTransform: 적포커스_원거리),
            S(StepType.Delay, duration: 0.4f),
            S(StepType.ShowCommsLine, speaker: "브로커", message: "맞으면 접속이 흔들린다.", duration: 0.75f),
            S(StepType.ShowCommsLine, speaker: "주인공", message: "맞으면.", duration: 0.5f),
            S(StepType.HideComms),
            S(StepType.SetCameraTarget),
            S(StepType.Delay, duration: 0.3f),
            S(StepType.UnfreezeTime),
            S(StepType.ShowSystemLog, message: "↓ + ← / → : 회피"),
            S(StepType.WaitForInput, inputWait: InputWaitType.Roll),
            S(StepType.FadeSystemLog, alpha: 0f, duration: 0.5f),
        });

        CreateTrigger(트리거부모, "트리거_원거리적", 시퀀스_원거리);

        // ========== 구간 6: HOME 코어 ==========
        var 시퀀스_HOME코어 = CreateSequence(시퀀스부모, "시퀀스_HOME코어", playOnStart: false, new Step[]
        {
            S(StepType.LockPlayer),
            S(StepType.FreezeTime),
            S(StepType.ShowSystemLog, message: "[회수 대상 확인]\n파일명: HOME\n보호 등급: 비정상적으로 높음", duration: 1f),
            S(StepType.ShowCommsLine, speaker: "주인공", message: "이 정도 보호를 걸 파일은 아닌데.", duration: 1f),
            S(StepType.ShowCommsLine, speaker: "브로커", message: "판단하지 마. 회수해.", duration: 0.75f),
            S(StepType.HideComms),
            S(StepType.UnfreezeTime),
            S(StepType.ShowSystemLog, message: "E 길게 누르기 : HOME 회수", duration: 0.75f),
            S(StepType.HoldInteractProgress, message: "[HOME 회수 중]", duration: 3f, progressFrom: 0f, progressTo: 100f, glitchIntensity: 0.9f),
            S(StepType.ShowSystemLog, message: "[심층 잠금 발생]\n[잔류 인격 반응 감지]\n[접속 불안정]", duration: 1f),
            S(StepType.GlitchPulse, duration: 0.3f, glitchIntensity: 1f),
            S(StepType.CameraShake, duration: 0.2f, strength: 0.22f),
            S(StepType.ShowCommsLine, speaker: "브로커", message: "뭐야, 왜 안 빠져?", duration: 0.75f),
            S(StepType.ShowCommsLine, speaker: "주인공", message: "파일이 심층에 물렸어.", duration: 0.75f),
            S(StepType.ShowCommsLine, speaker: "브로커", message: "끊어. 지금은 못 뽑는다.", duration: 0.75f),
            S(StepType.HideComms),
            S(StepType.ShowSystemLog, message: "[강제 복귀]", duration: 0.75f),
            S(StepType.FadeOut, duration: 0.5f),
            S(StepType.HideSystemLog),
            S(StepType.TeleportPlayer, targetTransform: 스폰_주인공집),
            S(StepType.SnapCamera),
            S(StepType.Delay, duration: 0.15f),
            S(StepType.FadeIn, duration: 0.5f),
            S(StepType.UnlockPlayer),
        });

        CreateInteractable(상호작용부모, "HOME코어", "E : 회수", 시퀀스_HOME코어, interactOnce: true);
        DeleteChildIfExists(트리거부모, "트리거_접속실패");
        DeleteChildIfExists(시퀀스부모, "시퀀스_접속실패");

        // ========== Phase E: 주인공집 ==========
        var 시퀀스_집복귀 = CreateSequence(시퀀스부모, "시퀀스_집복귀", playOnStart: false, new Step[]
        {
            S(StepType.ShowSystemLog, message: "[회수 실패]\n[파일 일부만 확보]\n[채무 패널티 예정]", duration: 1.25f),
            S(StepType.ShowCommsLine, speaker: "주인공", message: "...젠장.", duration: 0.75f),
            S(StepType.HideComms),
            S(StepType.FadeSystemLog, alpha: 0f, duration: 0.5f),
        });

        CreateTrigger(트리거부모, "트리거_집복귀연출", 시퀀스_집복귀);

        // 단말기 (반복 가능)
        var 시퀀스_단말기 = CreateSequence(시퀀스부모, "시퀀스_단말기", playOnStart: false, playOnce: false, steps: new Step[]
        {
            S(StepType.LockInput),
            S(StepType.ShowSystemLog, message: "[채무 잔액]\n83,420C\n\n[최근 의뢰]\nHOME 회수 실패\n\n[브로커 메시지]\n파일이 심층에 잠겼다.\n원본 칩에 직접 접속해야 한다.\n광장으로 나와.", duration: 2f),
            S(StepType.HideSystemLog),
            S(StepType.UnlockInput),
        });

        CreateInteractable(상호작용부모, "단말기", "E : 확인", 시퀀스_단말기);

        // 거울 (반복 가능 — 분위기 자기인식용)
        var 시퀀스_거울 = CreateSequence(시퀀스부모, "시퀀스_거울", playOnStart: false, playOnce: false, steps: new Step[]
        {
            S(StepType.ShowSystemLog, message: "[거울]\n눈이 흐려져 있다.\n칩이 박힌 자리는 늘 미열이 돈다.", duration: 1.5f),
            S(StepType.HideSystemLog),
        });

        CreateInteractable(상호작용부모, "거울", "E : 본다", 시퀀스_거울);

        // 문 → 광장 (반복 가능)
        var 시퀀스_광장이동 = CreateSequence(시퀀스부모, "시퀀스_광장이동", playOnStart: false, playOnce: false, steps: new Step[]
        {
            S(StepType.LockPlayer),
            S(StepType.FadeOut, duration: 0.4f),
            S(StepType.TeleportPlayer, targetTransform: 스폰_광장),
            S(StepType.SnapCamera),
            S(StepType.Delay, duration: 0.2f),
            S(StepType.FadeIn, duration: 0.4f),
            S(StepType.UnlockPlayer),
        });

        CreateInteractable(상호작용부모, "문_광장으로", "밖으로 나간다.", 시퀀스_광장이동);

        // ========== Phase E: 광장 ==========
        var 시퀀스_접근거부 = CreateSequence(시퀀스부모, "시퀀스_접근거부", playOnStart: false, new Step[]
        {
            S(StepType.ShowSystemLog, message: "[접근 거부]\n[채무 등급: 위험]\n[상위 구역 출입 불가]", duration: 1f),
            S(StepType.ShowCommsLine, speaker: "주인공", message: "알고 있어.", duration: 0.75f),
            S(StepType.ShowCommsLine, speaker: "경비 AI", message: "반복 확인은 추가 요금이 발생합니다.", duration: 1f),
            S(StepType.ShowCommsLine, speaker: "주인공", message: "...진짜 최악이네.", duration: 0.75f),
            S(StepType.HideComms),
            S(StepType.HideSystemLog),
        });

        CreateTrigger(트리거부모, "트리거_접근거부", 시퀀스_접근거부);

        // 문 → 골목길 (반복 가능)
        var 시퀀스_골목이동 = CreateSequence(시퀀스부모, "시퀀스_골목이동", playOnStart: false, playOnce: false, steps: new Step[]
        {
            S(StepType.LockPlayer),
            S(StepType.FadeOut, duration: 0.4f),
            S(StepType.TeleportPlayer, targetTransform: 스폰_골목길),
            S(StepType.SnapCamera),
            S(StepType.Delay, duration: 0.2f),
            S(StepType.FadeIn, duration: 0.4f),
            S(StepType.UnlockPlayer),
        });

        CreateInteractable(상호작용부모, "문_골목길로", "골목길로 향한다.", 시퀀스_골목이동);

        // 노점상 NPC (반복 가능)
        var 시퀀스_노점상 = CreateSequence(시퀀스부모, "시퀀스_노점상", playOnStart: false, playOnce: false, steps: new Step[]
        {
            S(StepType.LockInput),
            S(StepType.ShowCommsLine, speaker: "노점상", message: "다이버는 칩 검문을 두 번 받는다지.", duration: 1f),
            S(StepType.ShowCommsLine, speaker: "주인공", message: "...정보 있어?", duration: 0.75f),
            S(StepType.ShowCommsLine, speaker: "노점상", message: "심층 다이버한테 줄 정보는 비싸. 다음에.", duration: 1f),
            S(StepType.HideComms),
            S(StepType.UnlockInput),
        });

        CreateInteractable(상호작용부모, "노점상", "E : 말을 건다", 시퀀스_노점상);

        // 게이트 물체 (반복 가능 — 짧은 시스템로그만)
        var 시퀀스_게이트 = CreateSequence(시퀀스부모, "시퀀스_게이트", playOnStart: false, playOnce: false, steps: new Step[]
        {
            S(StepType.ShowSystemLog, message: "[게이트]\n[채무 등급 부족]\n[통과 불가]", duration: 1.25f),
            S(StepType.HideSystemLog),
        });

        CreateInteractable(상호작용부모, "게이트", "E : 살펴본다", 시퀀스_게이트);

        // 게이트 설명 AI NPC (반복 가능)
        var 시퀀스_게이트설명 = CreateSequence(시퀀스부모, "시퀀스_게이트설명", playOnStart: false, playOnce: false, steps: new Step[]
        {
            S(StepType.LockInput),
            S(StepType.ShowCommsLine, speaker: "안내 AI", message: "이 게이트는 채무 등급으로 작동합니다.", duration: 1f),
            S(StepType.ShowCommsLine, speaker: "안내 AI", message: "잔액을 줄이거나 위탁 의뢰를 완료해야 통과할 수 있습니다.", duration: 1.25f),
            S(StepType.ShowCommsLine, speaker: "주인공", message: "위탁이라.", duration: 0.5f),
            S(StepType.HideComms),
            S(StepType.UnlockInput),
        });

        CreateInteractable(상호작용부모, "게이트설명_AI", "E : 안내 받는다", 시퀀스_게이트설명);

        // 행인 NPC (반복 가능)
        var 시퀀스_행인 = CreateSequence(시퀀스부모, "시퀀스_행인", playOnStart: false, playOnce: false, steps: new Step[]
        {
            S(StepType.LockInput),
            S(StepType.ShowCommsLine, speaker: "행인", message: "다이버지? 머리에 박힌 거 다 보여.", duration: 1f),
            S(StepType.ShowCommsLine, speaker: "주인공", message: "...그래서.", duration: 0.5f),
            S(StepType.ShowCommsLine, speaker: "행인", message: "그냥. 빚 줄어드는 거 부럽다고.", duration: 1f),
            S(StepType.HideComms),
            S(StepType.UnlockInput),
        });

        CreateInteractable(상호작용부모, "행인", "E : 말을 건다", 시퀀스_행인);

        // ========== Phase E: 골목길 ==========
        var 시퀀스_브로커대화 = CreateSequence(시퀀스부모, "시퀀스_브로커대화", playOnStart: false, new Step[]
        {
            S(StepType.LockInput),
            S(StepType.ShowCommsLine, speaker: "브로커", message: "늦었군.", duration: 0.75f),
            S(StepType.ShowCommsLine, speaker: "주인공", message: "튕겼어.", duration: 0.5f),
            S(StepType.ShowCommsLine, speaker: "브로커", message: "변명은 비싸고 결과는 싸다.", duration: 1f),
            S(StepType.ShowCommsLine, speaker: "주인공", message: "HOME은 뭐야?", duration: 0.75f),
            S(StepType.ShowCommsLine, speaker: "브로커", message: "거주권 키일 가능성이 높다.", duration: 1f),
            S(StepType.ShowCommsLine, speaker: "브로커", message: "죽은 채무자가 숨긴 마지막 자산이지.", duration: 1f),
            S(StepType.ShowCommsLine, speaker: "주인공", message: "보호가 너무 강했어.", duration: 0.75f),
            S(StepType.ShowCommsLine, speaker: "브로커", message: "그래서 네가 들어가는 거다.", duration: 0.75f),
            S(StepType.ShowCommsLine, speaker: "주인공", message: "보상은?", duration: 0.5f),
            S(StepType.ShowCommsLine, speaker: "브로커", message: "회수하면 채무 일부를 줄여주지.", duration: 1f),
            S(StepType.ShowCommsLine, speaker: "주인공", message: "일부?", duration: 0.5f),
            S(StepType.ShowCommsLine, speaker: "브로커", message: "네 목숨값보단 비싸.", duration: 1f),
            S(StepType.HideComms),
            S(StepType.UnlockInput),
        });

        CreateTrigger(트리거부모, "트리거_브로커대화", 시퀀스_브로커대화);

        // 칩 장치 → 채무자 047 심층 재접속 (같은 씬 내 스폰_재접속_047로 텔레포트)
        var 시퀀스_칩접속 = CreateSequence(시퀀스부모, "시퀀스_칩접속", playOnStart: false, new Step[]
        {
            S(StepType.LockPlayer),
            S(StepType.ShowCommsLine, speaker: "브로커", message: "심층에 남은 인격이 있을 수 있다.", duration: 1f),
            S(StepType.ShowCommsLine, speaker: "브로커", message: "말 걸지 마. 베고, 뽑고, 나와.", duration: 1f),
            S(StepType.ShowCommsLine, speaker: "주인공", message: "늘 하던 대로.", duration: 0.75f),
            S(StepType.HideComms),
            // 검은 화면으로 전환 + 재접속 시스템로그 (구간 1 패턴 재현)
            S(StepType.FadeOut, duration: 0.5f),
            S(StepType.ShowSystemLog, message: "[접속 재개...]\n[대상: 채무자 047]\n[심층 침투 경로 확보]", duration: 1.25f),
            // 스폰_재접속_047 (공중 위치)로 텔레포트 → 자유낙하 연출
            S(StepType.TeleportPlayer, targetTransform: 스폰_재접속_047),
            S(StepType.SnapCamera),
            S(StepType.FadeIn, duration: 0.5f),
            // 낙하 중 브로커 짧은 한 마디
            S(StepType.ShowCommsLine, speaker: "브로커", message: "이번엔 끝까지 가라.", duration: 1f),
            S(StepType.HideComms),
            S(StepType.HideSystemLog),
            S(StepType.UnlockPlayer),
        });

        CreateInteractable(상호작용부모, "칩장치", "E : 원본 칩 접속", 시퀀스_칩접속, interactOnce: true);

        // 씬 저장
        EditorSceneManager.SaveOpenScenes();
        Debug.Log("[튜토리얼 콘텐츠] 생성 완료. 시퀀스/트리거/진행 차단/상호작용이 배치되었습니다.\n" +
            "수동 작업 필요:\n" +
            "- 진행차단_첫적, 진행차단_연속전투: enemies 배열에 적 오브젝트 연결\n" +
            "- 트리거/상호작용 오브젝트: 씬 뷰에서 위치 조정\n" +
            "- HOME코어, 단말기, 문, 칩장치: 각 맵 영역 내 원하는 위치로 이동\n" +
            "- 스폰_재접속_047: 튜토리얼진행/스폰포인트 하위에 신규 빈 오브젝트 생성 후 채무자 047 심층 공중 위치에 배치 (TutorialMarker SpawnPoint 추가 권장)\n" +
            "- 신규 상호작용(거울/노점상/게이트/게이트설명_AI/행인): 씬 뷰에서 각 위치로 이동 (튜토리얼진행/상호작용 하위에 생성됨)");
    }

    // === 헬퍼 ===

    // 주의: 실제 SceneEventSequence.StepType과 순서가 1:1로 맞아야 한다.
    // ApplySequence가 (int) 캐스팅으로 SerializedProperty에 저장하기 때문.
    enum StepType
    {
        Delay, LockPlayer, UnlockPlayer, ShowSystemLog, HideSystemLog,
        SetSystemLogAlpha, FadeSystemLog, ShowCommsLine, HideComms, SetObjectActive,
        WaitForInput, TeleportPlayer, SnapCamera, WaitForEnemiesDead,
        FadeOut, FadeIn, PlaySequence, CameraShake, GlitchPulse, GlitchFade, ShowProgressLog,
        HoldInteractProgress, CameraFocus,
        FreezeTime, UnfreezeTime, SetCameraTarget,
        LockInput, UnlockInput
    }

    enum InputWaitType { AnyKey, Move, Jump, Dash, Attack, Interact, Roll }

    struct Step
    {
        public StepType type;
        public string speaker, message;
        public float duration, alpha, strength, glitchIntensity, progressFrom, progressTo;
        public InputWaitType inputWait;
        public Transform targetTransform;
        public SceneEventSequence targetSequence;
    }

    static Step S(StepType type, string speaker = "", string message = "",
        float duration = 0f, float alpha = 1f,
        float strength = 0.15f, float glitchIntensity = 0.6f,
        float progressFrom = 0f, float progressTo = 100f,
        InputWaitType inputWait = InputWaitType.AnyKey,
        Transform targetTransform = null,
        SceneEventSequence targetSequence = null)
    {
        return new Step
        {
            type = type, speaker = speaker, message = message,
            duration = duration, alpha = alpha,
            strength = strength, glitchIntensity = glitchIntensity,
            progressFrom = progressFrom, progressTo = progressTo,
            inputWait = inputWait, targetTransform = targetTransform,
            targetSequence = targetSequence
        };
    }

    static SceneEventSequence CreateSequence(Transform parent, string name, bool playOnStart, Step[] steps, bool playOnce = true)
    {
        // 같은 이름의 시퀀스가 이미 있으면 내용을 갱신합니다.
        var existing = parent.Find(name);
        if (existing != null)
        {
            var existingSeq = existing.GetComponent<SceneEventSequence>();
            if (existingSeq != null)
            {
                Debug.Log($"[TutorialContentBuilder] '{name}' 이미 존재 — 시퀀스 갱신 (playOnce={playOnce})");
                return ApplySequence(existingSeq, playOnStart, steps, playOnce);
            }
        }

        var go = new GameObject(name);
        go.transform.SetParent(parent, false);
        var seq = go.AddComponent<SceneEventSequence>();

        return ApplySequence(seq, playOnStart, steps, playOnce);
    }

    static SceneEventSequence ApplySequence(SceneEventSequence seq, bool playOnStart, Step[] steps, bool playOnce)
    {
        var so = new SerializedObject(seq);
        so.FindProperty("playOnStart").boolValue = playOnStart;
        so.FindProperty("playOnce").boolValue = playOnce;

        var stepsProperty = so.FindProperty("steps");
        stepsProperty.ClearArray();

        for (int i = 0; i < steps.Length; i++)
        {
            stepsProperty.InsertArrayElementAtIndex(i);
            var elem = stepsProperty.GetArrayElementAtIndex(i);
            elem.FindPropertyRelative("type").enumValueIndex = (int)steps[i].type;
            elem.FindPropertyRelative("speaker").stringValue = steps[i].speaker;
            elem.FindPropertyRelative("message").stringValue = steps[i].message;
            elem.FindPropertyRelative("duration").floatValue = steps[i].duration;
            elem.FindPropertyRelative("alpha").floatValue = steps[i].alpha;
            elem.FindPropertyRelative("strength").floatValue = steps[i].strength;
            elem.FindPropertyRelative("glitchIntensity").floatValue = steps[i].glitchIntensity;
            elem.FindPropertyRelative("progressFrom").floatValue = steps[i].progressFrom;
            elem.FindPropertyRelative("progressTo").floatValue = steps[i].progressTo;
            elem.FindPropertyRelative("inputWaitType").enumValueIndex = (int)steps[i].inputWait;
            elem.FindPropertyRelative("active").boolValue = false;

            elem.FindPropertyRelative("targetTransform").objectReferenceValue = steps[i].targetTransform;

            if (steps[i].targetSequence != null)
            {
                elem.FindPropertyRelative("targetSequence").objectReferenceValue = steps[i].targetSequence;
                elem.FindPropertyRelative("waitForCompletion").boolValue = true;
            }
        }

        so.ApplyModifiedPropertiesWithoutUndo();
        return seq;
    }

    static Transform FindEnemyByName(string namePrefix)
    {
        // 같은 이름으로 시작하는 활성 적 중 가장 작은 x 좌표(왼쪽)를 우선.
        var enemies = Object.FindObjectsByType<EnemyInteraction>(FindObjectsInactive.Exclude, FindObjectsSortMode.None);
        Transform best = null;
        float bestX = float.MaxValue;
        for (int i = 0; i < enemies.Length; i++)
        {
            var e = enemies[i];
            if (e == null || !e.gameObject.activeInHierarchy) continue;
            if (!e.name.StartsWith(namePrefix)) continue;
            if (e.transform.position.x < bestX)
            {
                bestX = e.transform.position.x;
                best = e.transform;
            }
        }
        return best;
    }

    static Transform FindEnemyFocusTarget()
    {
        var enemyInteractions = Object.FindObjectsByType<EnemyInteraction>(FindObjectsInactive.Include, FindObjectsSortMode.None);
        if (enemyInteractions != null && enemyInteractions.Length > 0 && enemyInteractions[0] != null)
        {
            return enemyInteractions[0].transform;
        }

        var enemies = Object.FindObjectsByType<Transform>(FindObjectsInactive.Include, FindObjectsSortMode.None);
        for (int i = 0; i < enemies.Length; i++)
        {
            Transform target = enemies[i];
            if (target == null)
            {
                continue;
            }

            string name = target.name;
            if (name.StartsWith("포커스_") || IsUnderTutorialProgress(target))
            {
                continue;
            }

            if (name.Contains("BlindHuntressEnemy") || name.Contains("Enemy") || name.Contains("적") || name.Contains("드론") || name.Contains("방어") || name.Contains("감시"))
            {
                return target;
            }
        }

        Debug.LogWarning("[TutorialContentBuilder] 포커스할 적을 찾지 못했습니다. CameraFocus 단계는 대기만 수행합니다.");
        return null;
    }

    static bool IsUnderTutorialProgress(Transform target)
    {
        while (target != null)
        {
            if (target.name == "튜토리얼진행")
            {
                return true;
            }

            target = target.parent;
        }

        return false;
    }

    static void DeleteChildIfExists(Transform parent, string name)
    {
        Transform existing = parent != null ? parent.Find(name) : null;
        if (existing != null)
        {
            Object.DestroyImmediate(existing.gameObject);
            Debug.Log($"[TutorialContentBuilder] '{name}' 제거");
        }
    }

    static void CreateTrigger(Transform parent, string name, SceneEventSequence sequence)
    {
        var existing = parent.Find(name);
        if (existing != null)
        {
            // 이미 존재하면 위치/크기는 보존하고 시퀀스 wire만 갱신.
            var existingTrig = existing.GetComponent<SceneEventTrigger2D>();
            if (existingTrig != null)
            {
                var existingSo = new SerializedObject(existingTrig);
                existingSo.FindProperty("sequence").objectReferenceValue = sequence;
                existingSo.ApplyModifiedPropertiesWithoutUndo();
                Debug.Log($"[TutorialContentBuilder] '{name}' 이미 존재 — 시퀀스 wire 갱신");
            }
            else
            {
                Debug.LogWarning($"[TutorialContentBuilder] '{name}' 존재하지만 SceneEventTrigger2D 컴포넌트 없음 — 스킵");
            }
            return;
        }

        var go = new GameObject(name);
        go.transform.SetParent(parent, false);
        go.layer = LayerMask.NameToLayer("Trigger");

        var col = go.AddComponent<BoxCollider2D>();
        col.isTrigger = true;
        col.size = new Vector2(3f, 4f);

        var trigger = go.AddComponent<SceneEventTrigger2D>();
        var so = new SerializedObject(trigger);
        so.FindProperty("sequence").objectReferenceValue = sequence;
        so.FindProperty("triggerOnce").boolValue = true;
        so.ApplyModifiedPropertiesWithoutUndo();

        var marker = go.AddComponent<TutorialMarker>();
        var markerSo = new SerializedObject(marker);
        markerSo.FindProperty("markerType").enumValueIndex = 1; // Trigger
        markerSo.ApplyModifiedPropertiesWithoutUndo();
    }

    static void CreateProgressBlocker(Transform parent, string name, SceneEventSequence onOpenSequence)
    {
        if (parent.Find(name) != null)
        {
            Debug.Log($"[TutorialContentBuilder] '{name}' 이미 존재 — 스킵");
            return;
        }

        var go = new GameObject(name);
        go.transform.SetParent(parent, false);

        var visual = new GameObject("차단비주얼");
        visual.transform.SetParent(go.transform, false);
        var col = visual.AddComponent<BoxCollider2D>();
        col.size = new Vector2(1f, 4f);

        var blocker = go.AddComponent<TutorialGate>();
        var so = new SerializedObject(blocker);
        so.FindProperty("gateVisual").objectReferenceValue = visual;
        so.FindProperty("startClosed").boolValue = true;
        if (onOpenSequence != null)
        {
            so.FindProperty("onOpenSequence").objectReferenceValue = onOpenSequence;
        }
        so.ApplyModifiedPropertiesWithoutUndo();

        var marker = go.AddComponent<TutorialMarker>();
        var markerSo = new SerializedObject(marker);
        markerSo.FindProperty("markerType").enumValueIndex = 2; // Progress Blocker
        markerSo.ApplyModifiedPropertiesWithoutUndo();
    }

    static void CreateInteractable(Transform parent, string name, string promptText, SceneEventSequence sequence, bool interactOnce = false)
    {
        var existing = parent.Find(name);
        if (existing != null)
        {
            // 이미 존재하면 핵심 필드(promptText / onInteractSequence / interactOnce)만 갱신.
            // 위치, 콜라이더 크기 등 수동으로 조정한 값은 보존.
            var existingInter = existing.GetComponent<Interactable>();
            if (existingInter != null)
            {
                var existingSo = new SerializedObject(existingInter);
                existingSo.FindProperty("promptText").stringValue = promptText;
                existingSo.FindProperty("onInteractSequence").objectReferenceValue = sequence;
                existingSo.FindProperty("interactOnce").boolValue = interactOnce;
                existingSo.ApplyModifiedPropertiesWithoutUndo();
                Debug.Log($"[TutorialContentBuilder] '{name}' 이미 존재 — 필드 갱신 (interactOnce={interactOnce})");
            }
            else
            {
                Debug.LogWarning($"[TutorialContentBuilder] '{name}' 존재하지만 Interactable 컴포넌트 없음 — 스킵");
            }
            return;
        }

        var go = new GameObject(name);
        go.transform.SetParent(parent, false);

        var col = go.AddComponent<BoxCollider2D>();
        col.isTrigger = true;
        col.size = new Vector2(2f, 3f);

        var inter = go.AddComponent<Interactable>();
        var so = new SerializedObject(inter);
        so.FindProperty("promptText").stringValue = promptText;
        so.FindProperty("onInteractSequence").objectReferenceValue = sequence;
        so.FindProperty("interactOnce").boolValue = interactOnce;
        so.ApplyModifiedPropertiesWithoutUndo();

        var marker = go.AddComponent<TutorialMarker>();
        var markerSo = new SerializedObject(marker);
        markerSo.FindProperty("markerType").enumValueIndex = 3; // Interactable
        markerSo.ApplyModifiedPropertiesWithoutUndo();
    }

    static void ClearChildren(Transform parent)
    {
        if (parent == null) return;
        while (parent.childCount > 0)
        {
            Object.DestroyImmediate(parent.GetChild(0).gameObject);
        }
    }
}
